// =============================================================================
// Smart Pantry — fill these BEFORE App Store / TestFlight production builds
// =============================================================================
// Replace every YOUR_* value with your real AWS / App Store / backend IDs.
// Do NOT commit real secrets to a public repo. Keep this file private or use
// Config/Secrets.local.xcconfig (gitignored) and `#include` it below.
//
// Cognito: AWS Console → Cognito → User pools → your pool → App integration
//   • Create a PUBLIC app client (no client secret)
//   • Enable ALLOW_USER_PASSWORD_AUTH + ALLOW_REFRESH_TOKEN_AUTH
// Database: Cognito is auth only. Pantry data stays on-device until Cloud API
//   is live. Fill Cloud* when you stand up API Gateway + RDS PostgreSQL.
// =============================================================================

// --- Amazon Cognito (REQUIRED for production sign-in) ---
COGNITO_REGION = us-east-1
COGNITO_USER_POOL_ID = us-east-1_iSK7Dx9Yf
COGNITO_APP_CLIENT_ID = 1sei4acpegc19jcftbklsng6n0
COGNITO_OAUTH_DOMAIN = us-east-1isk7dx9yf.auth.us-east-1.amazoncognito.com
COGNITO_OAUTH_REDIRECT_URI = intelligentliving://signin

// --- Future cloud sync (API in front of RDS PostgreSQL) ---
// Leave as YOUR_* until the backend exists. App stays fully on-device.
CLOUD_API_BASE_URL = YOUR_CLOUD_API_BASE_URL
CLOUD_API_KEY = YOUR_CLOUD_API_KEY
AWS_ACCOUNT_ID = YOUR_AWS_ACCOUNT_ID
RDS_DATABASE_HOST = YOUR_RDS_POSTGRES_HOST
RDS_DATABASE_NAME = smart_pantry
RDS_DATABASE_PORT = 5432

// --- App Store / support ---
SUPPORT_EMAIL = support@smartpantry.app
PRIVACY_POLICY_URL = https://cloudcommercialholdings.github.io/smart-pantry/privacy.html
TERMS_OF_USE_URL = https://cloudcommercialholdings.github.io/smart-pantry/terms.html
APP_STORE_ID = YOUR_APP_STORE_NUMERIC_ID

// Local IDs (gitignored). Create this file if missing.
#include? "Secrets.local.xcconfig"
